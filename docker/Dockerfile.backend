# 多阶段构建 - 后端
FROM golang:1.21-alpine AS builder

WORKDIR /app

# 设置 Go modules proxy (使用国内镜像加速)
ENV GOPROXY=https://goproxy.cn,direct
ENV GO111MODULE=on

# 安装必要的工具
RUN apk add --no-cache git

# 复制 go mod 文件
COPY backend/go.mod backend/go.sum ./

# 下载依赖
RUN go mod download && go mod verify

# 复制源代码
COPY backend/ ./

# 构建应用
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o updatehub-server ./cmd/server

# 最终镜像
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /root/

# 复制构建的二进制文件
COPY --from=builder /app/updatehub-server .

# 复制配置文件
COPY --from=builder /app/configs ./configs

# 创建上传目录
RUN mkdir -p uploads

# 设置时区
ENV TZ=Asia/Shanghai

EXPOSE 8080

CMD ["./updatehub-server"]
