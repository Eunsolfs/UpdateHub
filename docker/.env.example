# UpdateHub 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# Docker 镜像配置（CI/CD 部署）
# 将 your-username 替换为你的 GitHub 用户名（必须小写）
BACKEND_IMAGE=ghcr.io/your-username/updatehub-backend:latest
FRONTEND_IMAGE=ghcr.io/your-username/updatehub-frontend:latest
UPDATEHUB_VERSION=latest

# 使用特定版本（例如 v1.0.0）：
# BACKEND_IMAGE=ghcr.io/your-username/updatehub-backend:v1.0.0
# FRONTEND_IMAGE=ghcr.io/your-username/updatehub-frontend:v1.0.0
# UPDATEHUB_VERSION=v1.0.0

# 数据库配置
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_DB=updatehub
POSTGRES_USER=updatehub

# Redis 配置
REDIS_PASSWORD=your_redis_password_here  # 留空表示不设置密码

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_this_in_production
REFRESH_SECRET=your_refresh_secret_key_change_this_in_production

# 服务器配置
SERVER_MODE=release  # debug 或 release
SERVER_PORT=8080

# 存储配置
STORAGE_TYPE=local  # local, s3, cos, minio

# S3 配置（如果使用 S3 存储）
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://s3.amazonaws.com

# 腾讯云 COS 配置（如果使用 COS 存储）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-name

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@updatehub.com

# 监控配置（可选）
ENABLE_METRICS=true
METRICS_PORT=9090

# 日志配置
LOG_LEVEL=info  # debug, info, warn, error
LOG_PATH=/var/log/updatehub
